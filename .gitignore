# =============================================================================
# .gitignore - Alzheimer Disease Detection Project
# =============================================================================

# ── Python cache & compiled files ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── IDE & editor files ────────────────────────────────────────────────────────
# Allow .vscode/extensions.json and launch.json but not personal settings
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# =============================================================================
# DATASET (never commit raw image data)
# =============================================================================
# Exclude all image files inside any dataset subdirectory
data/dataset/Non_Demented/
data/dataset/Very_Mild_Demented/
data/dataset/Mild_Demented/
data/dataset/Moderate_Demented/
data/raw/
data/cache/
checkpoints/
runs/
outputs/
reports/generated/

# Always keep the placeholder .gitkeep files so directory structure is tracked
!data/dataset/Non_Demented/.gitkeep
!data/dataset/Very_Mild_Demented/.gitkeep
!data/dataset/Mild_Demented/.gitkeep
!data/dataset/Moderate_Demented/.gitkeep
!data/raw/.gitkeep
!data/test_samples/.gitkeep
# Allow lightweight curated demo samples (12 files, ~50 KB) for deployment
!data/test_samples/*.jpg
!data/test_samples/*.png


# =============================================================================
# MODEL CHECKPOINTS (large binary files)
# ResNet-18 is 128 MB (exceeds GitHub 100 MB limit) -> Hosted as GitHub Release asset
# MobileNetV2 (26 MB) and EfficientNet-B0 (46 MB) are tracked for zero-setup deployment
# =============================================================================
results/models/*.pt
results/models/*.pth
results/models/*.pkl
results/models/*.bin
results/models/*.onnx

# Allow checkpoints under GitHub 100 MB limit for deployment
!results/models/mobilenet_v2_best.pt
!results/models/efficientnet_b0_best.pt
!results/models/.gitkeep


# =============================================================================
# GENERATED EXPERIMENT OUTPUTS
# Track metrics, evaluation figures, and error analysis required by Streamlit
# =============================================================================
!results/metrics/*.json
!results/metrics/*.csv
!results/metrics/*.md
!results/figures/**
!results/error_analysis/**
!results/robustness/**
!results/calibration/**


# =============================================================================
# LOGS
# =============================================================================
*.log
logs/

# =============================================================================
# STREAMLIT RUNTIME
# =============================================================================
.streamlit/secrets.toml
!.streamlit/config.toml


# =============================================================================
# JUPYTER
# =============================================================================
.ipynb_checkpoints/
*.ipynb

# =============================================================================
# TEMPORARY / SCRATCH FILES
# =============================================================================
*.tmp
*.temp
scratch/
